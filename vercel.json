  "crons": [
    { "path": "/api/notifications?action=send-daily-reminders", "schedule": "30 5 * * 1-5" },
    { "path": "/api/notifications?action=send-tag-reminders",   "schedule": "0 21 * * *"   },
    { "path": "/api/notifications?action=send-licence-reminders", "schedule": "10 21 * * *" },
    { "path": "/api/notifications?action=send-daily-digest",    "schedule": "0 7 * * 1-5"  },
    { "path": "/api/notifications?action=send-stale-snags",     "schedule": "0 23 * * 0"   },
    { "path": "/api/notifications?action=send-inactive-users",  "schedule": "0 23 * * 1"   },
    { "path": "/api/payroll-reminder",                          "schedule": "0 8 * * 0"    },
    { "path": "/api/payroll-reminder",                          "schedule": "30 21 * * 0"  },
    { "path": "/api/cash-watch?action=check-overruns",          "schedule": "30 22 * * *"  },
    { "path": "/api/users?action=sweep",                        "schedule": "0 19 * * *"   },
    { "path": "/api/backup-snapshot?action=run",                "schedule": "0 16 * * *"   },
    { "path": "/api/internal/sync-checks/hours",                "schedule": "0 17 * * *"   },
    { "path": "/api/internal/sync-checks/structure",            "schedule": "0 18 * * *"   },
    { "path": "/api/internal/mirror-tasks",                     "schedule": "*/10 * * * *" },
    { "path": "/api/internal/mirror-evidence",                  "schedule": "*/15 * * * *" },
    { "path": "/api/insights-digest?action=generate",           "schedule": "0 21 * * 0"   },
    { "path": "/api/office-daily-summary?action=generate",      "schedule": "30 20 * * *"  }
  ]

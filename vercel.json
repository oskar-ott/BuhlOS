{
  "framework": "nextjs",
  "functions": {
    "api/ai-drawings.js": { "maxDuration": 60 },
    "api/itp-simple.js": { "maxDuration": 60 },
    "api/backup-snapshot.js": { "maxDuration": 60 },
    "api/internal/sync-checks/hours.js": { "maxDuration": 60 },
    "api/internal/sync-checks/structure.js": { "maxDuration": 60 },
    "api/internal/mirror-tasks.js": { "maxDuration": 60 },
    "api/internal/mirror-evidence.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/client", "destination": "/client.html" },
    { "source": "/client/jobs/:jobId", "destination": "/client.html" }
  ],
  "redirects": [
    { "source": "/login", "destination": "/v2/login", "permanent": false },
